# Copy to .env (gitignored) and fill in. RAM user needs AliyunSWASFullAccess + AliyunBSSReadOnlyAccess.
ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI_your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret

# Defaults / convenience (fill once you have a server)
ALIYUN_PROFILE=myaliyun
ALIYUN_REGION=cn-shanghai
SWAS_INSTANCE_ID=
SWAS_REGION=cn-shanghai
SERVER_IP=
SERVER_HOSTNAME=
SSH_KEY=~/.ssh/aliyun_deploy
